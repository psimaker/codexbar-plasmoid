#!/bin/sh
# Stand-in for the CodexBar CLI in the Plasma smoke test. Prints the recorded
# payloads in $CODEXBAR_FIXTURES with reset times relative to now, and keeps
# the enabled providers of its config.json in $CODEXBAR_MOCK_STATE (one
# CodexBar id per line; missing means only the default-enabled Codex, and
# "broken" a config.json the CLI cannot decode). The sources config.json
# stores are in $CODEXBAR_MOCK_STATE.sources ("id source" lines; missing means
# Claude's OAuth only), and every call's arguments are appended to
# $CODEXBAR_MOCK_STATE.calls. Fetching the provider named in
# $CODEXBAR_MOCK_CRASH crashes with SIGSEGV. With $CODEXBAR_MOCK_READONLY
# set, config.json cannot be written.
fixtures="${CODEXBAR_FIXTURES:?CODEXBAR_FIXTURES is not set}"
state="${CODEXBAR_MOCK_STATE:?CODEXBAR_MOCK_STATE is not set}"
sources="$state.sources"
providers="$fixtures/providers.txt"
printf '%s %s\n' "$(date +%s.%N)" "$*" >>"$state.calls"
decode_error="Failed to decode CodexBar config: The data isn't in the correct format."

# Like CodexBar 0.70 with a config.json it cannot decode, every command but
# --version fails; the JSON ones print an error envelope.
if [ "$(cat "$state" 2>/dev/null)" = broken ]; then
    case "${1:-} ${2:-}" in
        "--version "* | "-V "*)
            ;;
        "config enable" | "config disable")
            echo "Error: $decode_error" >&2
            exit 1
            ;;
        *)
            echo "[{\"provider\":\"cli\",\"source\":\"cli\",\"error\":{\"kind\":\"config\",\"code\":1,\"message\":\"$decode_error\"}}]"
            exit 1
            ;;
    esac
fi

iso() { date -u -d "$1" +%Y-%m-%dT%H:%M:%SZ; }

serve() {
    sed -e "s/@NOW@/$(iso now)/g" \
        -e "s/@TODAY@/$(date -u +%Y-%m-%d)/g" \
        -e "s/@IN_1H@/$(iso '+1 hour')/g" \
        -e "s/@IN_2H10M@/$(iso '+2 hours 10 minutes')/g" \
        -e "s/@IN_3H50M@/$(iso '+3 hours 50 minutes')/g" \
        -e "s/@IN_5H@/$(iso '+5 hours')/g" \
        -e "s/@IN_3D@/$(iso '+3 days 4 hours')/g" \
        -e "s/@IN_4D@/$(iso '+4 days 2 hours')/g" \
        -e "s/@IN_5D@/$(iso '+5 days 6 hours')/g" \
        -e "s/@IN_6D@/$(iso '+6 days 1 hour')/g" \
        "$fixtures/$1"
}

enabled_ids() {
    if [ -f "$state" ]; then cat "$state"; else echo codex; fi
}

stored_sources() {
    if [ -f "$sources" ]; then cat "$sources"; else echo "claude oauth"; fi
}

# CodexBar id for a --provider name or id, empty when unknown.
provider_id() {
    awk -v name="$1" '$1 == name || $2 == name { print $1; exit }' "$providers"
}

config_command() {
    case "$1" in
        providers)
            enabled_ids | awk 'NR == FNR { on[$1] = 1; next }
                { name = $3; for (i = 4; i <= NF; i++) name = name " " $i
                  printf "%s{\"displayName\":\"%s\",\"enabled\":%s,\"provider\":\"%s\",\"defaultEnabled\":%s}",
                      (n++ ? "," : "["), name, ($1 in on) ? "true" : "false", $1, ($1 == "codex") ? "true" : "false" }
                END { print "]" }' - "$providers"
            ;;
        dump)
            { enabled_ids | sed 's/^/on /'; stored_sources | sed 's/^/source /'; } \
                | awk 'NR == FNR { if ($1 == "on") on[$2] = 1; else src[$2] = $3; next }
                    { printf "%s{\"id\":\"%s\",\"enabled\":%s%s}", (n++ ? "," : "{\"providers\":["), $1,
                          ($1 in on) ? "true" : "false", ($1 in src) ? ",\"source\":\"" src[$1] "\"" : "" }
                    END { print "]}" }' - "$providers"
            ;;
        set-source)
            if [ -n "${CODEXBAR_MOCK_READONLY:-}" ]; then
                echo '[{"provider":"cli","source":"cli","error":{"kind":"config","code":1,"message":"Permission denied"}}]'
                exit 1
            fi
            id="$(provider_id "$3")"
            if [ -z "$id" ]; then
                echo '[{"provider":"cli","error":{"code":1,"message":"Unknown or missing provider. Use --provider <name>."}}]'
                exit 1
            fi
            case "$5" in
                auto | web | cli | oauth | api) ;;
                *)
                    echo '[{"provider":"cli","error":{"code":1,"message":"Unknown or missing source. Use --source auto|web|cli|oauth|api."}}]'
                    exit 1
                    ;;
            esac
            others="$(stored_sources | awk -v id="$id" '$1 != id')"
            if [ "$5" = auto ]; then
                printf '%s\n' "$others" | sed '/^$/d' >"$sources"
            else
                printf '%s\n%s %s\n' "$others" "$id" "$5" | sed '/^$/d' >"$sources"
            fi
            echo "{\"provider\":\"$id\",\"source\":\"$5\"}"
            ;;
        enable | disable)
            if [ -n "${CODEXBAR_MOCK_READONLY:-}" ]; then
                echo '[{"provider":"cli","source":"cli","error":{"kind":"config","code":1,"message":"Permission denied"}}]'
                exit 1
            fi
            id="$(provider_id "$3")"
            if [ -z "$id" ]; then
                echo '[{"provider":"cli","error":{"code":1,"message":"Unknown or missing provider."}}]'
                exit 1
            fi
            current="$(enabled_ids | grep -v -x -F "$id")"
            if [ "$1" = enable ]; then
                printf '%s\n%s\n' "$current" "$id" | sed '/^$/d' >"$state"
            else
                printf '%s\n' "$current" | sed '/^$/d' >"$state"
            fi
            echo "{\"provider\":\"$id\",\"enabled\":$([ "$1" = enable ] && echo true || echo false)}"
            ;;
        *)
            echo "mock codexbar: unsupported config command: $*" >&2
            exit 2
            ;;
    esac
}

case "${1:-}" in
    --version | -V)
        echo "CodexBar ${CODEXBAR_MOCK_VERSION:-0.70.0}"
        ;;
    usage)
        provider=""
        while [ $# -gt 0 ]; do
            if [ "$1" = "--provider" ]; then
                provider="$2"
            fi
            shift
        done
        if [ -n "$provider" ] && [ "$provider" = "${CODEXBAR_MOCK_CRASH:-}" ]; then
            kill -SEGV $$
        fi
        if [ -f "$fixtures/usage-$provider.json" ]; then
            serve "usage-$provider.json"
        else
            # Like the real CLI: an unknown --provider reports the providers
            # enabled in its own config instead of failing.
            serve "usage-codex.json"
        fi
        ;;
    config)
        shift
        config_command "$@"
        ;;
    cost)
        provider=""
        while [ $# -gt 0 ]; do
            if [ "$1" = "--provider" ]; then
                provider="$2"
            fi
            shift
        done
        if [ -f "$fixtures/cost-$provider.json" ]; then
            serve "cost-$provider.json"
        else
            echo "[]"
        fi
        ;;
    *)
        echo "mock codexbar: unsupported command: $*" >&2
        exit 2
        ;;
esac
